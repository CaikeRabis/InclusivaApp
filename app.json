{
  "expo": {
    "name": "InclusivaApp",
    "slug": "InclusivaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_2_inclusiva.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_1_inclusiva.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caikerabis.inclusivaapp"
    },
    "android": {
      "package": "com.caikerabis.inclusivaapp",
      "permissions": [
        "NFC",
        "READ_NFC",
        "WRITE_NFC",
        "android.permission.NFC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_1_inclusiva.png",
        "backgroundColor": "#0047BB"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logo_2_inclusiva.png"
    },
    "updates": {
      "url": "https://u.expo.dev/2f38a556-a565-4ffe-be3e-0a8a95df6d1d"
    },
    "plugins": [
      "react-native-nfc-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "2f38a556-a565-4ffe-be3e-0a8a95df6d1d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
